config KVDB
	tristate "key-value database"
	default n
	select UNQLITE

if KVDB

config KVDB_PRIORITY
	int "task priority"
	default 100

config KVDB_STACKSIZE
	int "stack size"
	default DEFAULT_TASK_STACKSIZE

config KVDB_RAM_PATH
	string "in-memory database path"
	default "/tmp/kv.db"

config KVDB_DAT_PATH
	string "persistent database path"
	default "/data/kv.db"

config KVDB_SRC_PATH
	string "database default value source path"
	default "/etc/build.prop"

endif # KVDB
