cc_defaults {
  name: "kvdb_defaults",
  proprietary: true,

  static_libs: [
    "libkvdb",
  ],
}

cc_library_static {
    name: "libkvdb",
    export_include_dirs: ["include"],

    srcs: [
        "kvdb/common.c",
        "kvdb/system_properties.c",
        "kvdb/client.c",
    ],

    cflags: [
        "-DCONFIG_KVDB_SERVER_CPUNAME=\"ap\"",
        "-fvisibility=hidden",
    ],
}

cc_library_headers {
    name: "likvdb_headers",
    export_include_dirs: ["include"],
    proprietary: true
}

cc_binary {
    name: "propset",
    srcs: ["kvdb/setprop.c"],
    defaults: ["kvdb_defaults"],
    proprietary: true,
}

cc_binary {
    name: "propget",
    srcs: ["kvdb/getprop.c"],
    defaults: ["kvdb_defaults"],
    proprietary: true,
}
